# URL interna (nombre del servicio en la red de Docker Compose), no localhost:
# la usan tanto auth.py (para traer las llaves públicas/JWKS) como los tests
# de integración (para pedir tokens) -- así el "iss" del token siempre
# coincide con lo que la app espera validar.
KEYCLOAK_URL=http://keycloak:8080